# loans-frontend/.env.example
# Copia a .env y ajusta. NO subas .env al repo.

# Puerto del frontend (dev server)
PORT=3004

# ✅ URL ÚNICA del API gateway. El SPA ya NO habla directo con cada microservicio:
# todo pasa por el gateway, que enruta /api/v1/{auth,profiles,loans,admin}/...
# En producción: https://api.tudominio.com
REACT_APP_API_URL=http://localhost:3005

# Ambiente
REACT_APP_ENV=development
REACT_APP_DEBUG=true

# NOTA: Las variables REACT_APP_AUTH_SERVICE_URL / REACT_APP_PROFILE_SERVICE_URL /
# REACT_APP_LOAN_SERVICE_URL / REACT_APP_ADMIN_SERVICE_URL quedaron OBSOLETAS
# (antes el front apuntaba a cada puerto 3000-3003). Ya no se usan.
